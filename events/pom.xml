<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tanhab.holdtheseat</groupId>
        <artifactId>holdtheseat</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>events</artifactId>
    <name>events</name>
    <description>Event DTOs shared by all three services. No service logic lives here.</description>

    <!-- No spring-boot-maven-plugin: repackaging a library as an executable jar
         would make it undependable. -->

    <dependencies>
        <!-- Annotations only. Jackson 3 moved core and databind to the tools.jackson
             group but deliberately left annotations here, so an annotated DTO compiles
             against either major. Databind belongs to whoever binds, which is never
             this module at runtime. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
