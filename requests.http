### Seat ids below are the seeded demo show from V2__seed_demo_show.sql.

@bookingHost = http://localhost:8081
@bookingKey = hts_dev_9f4c2a7b1e8d63054a9c2f7b3e1d8a60

@seatHost = http://localhost:8082
@seatKey = hts_dev_seat_3c8e5b1042fa96d7be40c25a71f8e9d3

@show = 11111111-1111-1111-1111-111111111111
@seatA1 = aaaaaaaa-0000-0000-0000-000000000001
@seatA2 = aaaaaaaa-0000-0000-0000-000000000002
@seatA3 = aaaaaaaa-0000-0000-0000-000000000003
@booking = 33333333-3333-3333-3333-333333333333
@otherBooking = 44444444-4444-4444-4444-444444444444

### seat: health, no key needed
GET {{seatHost}}/actuator/health

### seat: live map — AVAILABLE / HELD / SOLD merged from Postgres + Redis
GET {{seatHost}}/shows/{{show}}/seats
X-API-Key: {{seatKey}}

### seat: hold two seats -> 201
POST {{seatHost}}/holds
X-API-Key: {{seatKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "bookingId": "{{booking}}",
  "seatIds": ["{{seatA1}}", "{{seatA2}}"]
}

### seat: the same booking asking again -> 201, delivery is at-least-once
POST {{seatHost}}/holds
X-API-Key: {{seatKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "bookingId": "{{booking}}",
  "seatIds": ["{{seatA1}}", "{{seatA2}}"]
}

### seat: someone else wants one of them -> 409 naming the clash, and A2 is not held
POST {{seatHost}}/holds
X-API-Key: {{seatKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "bookingId": "{{otherBooking}}",
  "seatIds": ["{{seatA1}}", "{{seatA2}}"]
}

### seat: a seat that belongs to no show -> 400
POST {{seatHost}}/holds
X-API-Key: {{seatKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "bookingId": "{{otherBooking}}",
  "seatIds": ["99999999-9999-9999-9999-999999999999"]
}

### seat: unknown show -> 404
POST {{seatHost}}/holds
X-API-Key: {{seatKey}}
Content-Type: application/json

{
  "showId": "88888888-8888-8888-8888-888888888888",
  "bookingId": "{{otherBooking}}",
  "seatIds": ["{{seatA1}}"]
}

### seat: no key -> 401
POST {{seatHost}}/holds
Content-Type: application/json

{
  "showId": "{{show}}",
  "bookingId": "{{booking}}",
  "seatIds": ["{{seatA1}}"]
}

### seat: release -> 204
DELETE {{seatHost}}/holds/{{booking}}
X-API-Key: {{seatKey}}

### seat: release again -> 204, idempotent
DELETE {{seatHost}}/holds/{{booking}}
X-API-Key: {{seatKey}}

### booking: create -> 201 PENDING with a null amountCents, and BookingRequested on the topic
POST {{bookingHost}}/bookings
X-API-Key: {{bookingKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "seatIds": ["{{seatA1}}"],
  "customerId": "cust-42"
}

> {% client.global.set("lastBooking", response.body.id); %}

### booking: read it back a second later -> CONFIRMED, amountCents priced by the seat service
GET {{bookingHost}}/bookings/{{lastBooking}}
X-API-Key: {{bookingKey}}

### booking: saga diary for the happy path
### Expect BookingRequested, SeatsHeld, PaymentAuthorized, BookingConfirmed.
### Poll the seat map above while this runs: A1 AVAILABLE -> HELD -> SOLD.
GET {{bookingHost}}/bookings/{{lastBooking}}/timeline
X-API-Key: {{bookingKey}}

### booking: a card that always declines -> 201 PENDING, then CANCELLED
### customerId "decline-me" is the seeded decline rule (holdtheseat.gateway.decline-customer-id).
POST {{bookingHost}}/bookings
X-API-Key: {{bookingKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "seatIds": ["{{seatA3}}"],
  "customerId": "decline-me"
}

> {% client.global.set("declinedBooking", response.body.id); %}

### booking: read it back a second later -> CANCELLED, cancellationReason PAYMENT_FAILED
### The seats were held then released: no hold: key for seatA3 remains, and it is not in sold:.
GET {{bookingHost}}/bookings/{{declinedBooking}}
X-API-Key: {{bookingKey}}

### booking: saga diary for compensation
### Expect PaymentFailed, BookingCancelled, and SeatsReleased. Map: A3 back to AVAILABLE.
GET {{bookingHost}}/bookings/{{declinedBooking}}/timeline
X-API-Key: {{bookingKey}}

### booking: a seat already sold -> 201 PENDING, then CANCELLED with a different reason
### Run the happy-path booking for seatA1 above first, so seatA1 is SOLD when this arrives.
POST {{bookingHost}}/bookings
X-API-Key: {{bookingKey}}
Content-Type: application/json

{
  "showId": "{{show}}",
  "seatIds": ["{{seatA1}}"],
  "customerId": "cust-99"
}

> {% client.global.set("rejectedBooking", response.body.id); %}

### booking: read it back -> CANCELLED, cancellationReason SEATS_REJECTED
### No payment was ever attempted for this booking: the payments table has no row for it.
GET {{bookingHost}}/bookings/{{rejectedBooking}}
X-API-Key: {{bookingKey}}

### booking: saga diary for reject
### Expect BookingRequested, SeatsRejected, BookingCancelled — no SeatsReleased (freed 0).
GET {{bookingHost}}/bookings/{{rejectedBooking}}/timeline
X-API-Key: {{bookingKey}}
